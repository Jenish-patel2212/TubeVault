{
  "name": "tubevault",
  "version": "1.0.0",
  "private": true,
  "description": "TubeVault root script runner",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "frontend": "npm --prefix frontend run dev",
    "backend": "cd backend && venv\\Scripts\\python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "start": "start-app.bat",
    "online": "start-online.bat",
    "build": "cd frontend && npm install && npm run build && node -e \"require('fs').cpSync('dist', '../dist', {recursive: true})\"",
    "build:netlify": "build-netlify.bat",
    "preview": "npm --prefix frontend run preview"
  }
}
